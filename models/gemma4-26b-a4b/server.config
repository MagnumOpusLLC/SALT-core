# Gemma 4 server-owned runtime policy. Artifact paths remain operator inputs.
GEMMA4_MODEL_ID=${GEMMA4_MODEL_ID:-gemma-4-26b-a4b-it}
# SALT_GEMMA4_PHYSICAL_BUILD_ONLY_BEGIN v1
if false; then
# SALT_GEMMA4_PHYSICAL_BUILD_ONLY_END v1
GEMMA4_WORKERS=${GEMMA4_WORKERS:-4}
# SALT_GEMMA4_PHYSICAL_BUILD_ONLY_BEGIN v1
else
GEMMA4_WORKERS=${GEMMA4_WORKERS:-8}
fi
# SALT_GEMMA4_PHYSICAL_BUILD_ONLY_END v1
# SALT_GEMMA4_PHYSICAL_BUILD_ONLY_BEGIN v1
# One bounded server KV seat owns the normal 4,096-token context.
GEMMA4_CONTEXT_TOKENS=${GEMMA4_CONTEXT_TOKENS:-4096}
GEMMA4_MAX_OUTPUT_TOKENS=${GEMMA4_MAX_OUTPUT_TOKENS:-2048}
# SALT_GEMMA4_PHYSICAL_BUILD_ONLY_END v1
GEMMA4_CONTEXT_TOKENS=${GEMMA4_CONTEXT_TOKENS:-512}
GEMMA4_MAX_OUTPUT_TOKENS=${GEMMA4_MAX_OUTPUT_TOKENS:-128}
# SALT_GEMMA4_PHYSICAL_BUILD_ONLY_BEGIN v1
# Target N/F/Q/X defaults come only from the selected model platform recipe.
# Define the complete GEMMA4_TARGET_ROUTE_N/F/Q plus GEMMA4_TARGET_X tuple only
# for an explicit bounded startup override; partial tuples fail closed.
# SALT_GEMMA4_PHYSICAL_BUILD_ONLY_END v1
# Empty selects the model/platform recipe's qualified SALT_PREFILL_B.
GEMMA4_PREFILL_CHUNK_TOKENS=${GEMMA4_PREFILL_CHUNK_TOKENS:-}
GEMMA4_KV_BUDGET_GB=${GEMMA4_KV_BUDGET_GB:-1.0}
GEMMA4_TIMEOUT_S=${GEMMA4_TIMEOUT_S:-900}
GEMMA4_PORT=${GEMMA4_PORT:-8090}
GEMMA4_RUNTIME_READY=true
