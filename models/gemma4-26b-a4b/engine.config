# models/gemma4-26b-a4b/engine.config -- Gemma 4 engine blueprint.
# Model geometry stays in the registry; execution batching and backend policy
# live here as data and are exported to the native engine by launchers/tools.

# CPU is the ordinary deployment path. Full CUDA, Metal, and HIP recipes retain
# independent measured boundaries below the model layer; explicit GB10/V520
# hosting candidates do not change model-wide runtime readiness.
SALT_GEMMA_COMPUTE_NODE=cpu
SALT_GPU_TRUNK=0
SALT_GPU_BOUNDED_WEIGHTS=0
SALT_GPU_TRUNK_LAYER_VIEW=0
SALT_GPU_TRUNK_SHARED_POOL=0
SALT_GPU_TRUNK_EXACT_VIEWS=0
SALT_GPU_WEIGHT_ADDRESSABILITY=auto
SALT_GPU_EXPERT_VIEW=selected
SALT_METAL_Q4_SIMDGROUPS=0
SALT_METAL_Q4_MAX_DESCRIPTORS=0
SALT_METAL_Q4_WEIGHT_STATIONARY_MIN_B=0
# Synchronous per-cell Metal proof harness. Keep 0 for every ordinary request,
# server, qualification waterfall, and performance run. A setup may override to
# 1 for one bounded correctness proof only, then must return to 0.
SALT_GEMMA_METAL_EXACT_CELLS=0
SALT_TARGET_GPU_PROGRAM=0
SALT_TARGET_CPU_GRAPH=0
SALT_TEXT_FINE_TOKEN=0
SALT_TOKEN_CPU_FLOW=0
SALT_TOKEN_CPU_GRAPH=0
SALT_GPU_TRUNK_B=200

# Layer/projection B recipe. The engine selects by output-row geometry:
#   R >= 8192: QKV class; R >= 4096: Z class; R >= 2048: O class;
#   smaller projections use SALT_GPU_PREFILL_B.
# These caps are dormant while SALT_GPU_TRUNK=0 but remain model-owned data.
SALT_GPU_PREFILL_B=1024
SALT_GPU_B_QKV=1024
SALT_GPU_B_Z=1024
SALT_GPU_B_O=1024

# Layer-major CPU prefill and routed-expert crossover.
SALT_PREFILL_CHUNK=1
SALT_PREFILL_B=512
SALT_PREFILL_OPERATION_FLOW=0
SALT_PREFILL_RETAIN_LAYERS=1
SALT_PREFILL_DECODE_LOOKAHEAD=0
SALT_PREFILL_SHARED_ARENAS=0
SALT_PREFILL_GPU_ATTENTION=0
# Full-attention GPU backends may opt into the model's existing hybrid layout:
# 1,024 private ring rows on sliding layers and absolute rows on full layers.
SALT_GEMMA_GPU_KV_RING=0
# Existing exact full-GPU DECODE attention lowering. Keep default-off until its
# B1 physical realization is both state/KV exact and faster than CPU attention.
SALT_DECODE_GPU_ATTENTION=0
# Complete dense gate/up -> exact GeGLU -> down DECODE chain. Platform recipes
# enable only a measured state/KV-exact winner.
SALT_DECODE_GPU_DENSE_CHAIN=0
SALT_M2_BATCH=1
SALT_QKV_BATCH=1
SALT_ATTN_THREADS=8

# Generic target-dispatch policies are required native configuration, even when
# their optional execution paths remain disabled. Platform recipes may override
# the worker budget; absent policy must never be interpreted by the C runtime.
SALT_TARGET_AREA_WORKERS=8
SALT_TARGET_N_PARALLEL=0
SALT_EXPERT_MATRIX_WAVES=0
SALT_PREFILL_EXPERT_MATRIX_FLOW=0
SALT_TARGET_MATRIX_FLOW=0
SALT_TARGET_GPU_EXPERTS=0

# DPR model recipe. These are operating horizons, not ABI capacities.
# C retains SALT_DPR_MAX_HORIZON only as the portable hard ceiling.
SALT_DPR_DRAFT_N=4
SALT_DPR_PREFILL_N=64
SALT_DPR_QA_BUCKET_BITS=12
# Engine-level Mentor selector adaptation. The public CLI boolean owns
# activation; the blueprint pins only the policy identity transported to C.
SALT_DPR_MENTOR_POLICY_SHA256=1a205b4d8fb51a1d658c9f639df7c81697990ffdb72e5625ec14bd25cdb71503
# Orthogonal A0 Mindset Attention Nomogram. Its public CLI boolean independently
# owns NM activation; this value pins only the policy identity.
SALT_DPR_MINDSET_ATTENTION_POLICY_SHA256=1a205b4d8fb51a1d658c9f639df7c81697990ffdb72e5625ec14bd25cdb71503
# Qualified W8 tree-frontier CPU baseline: one decimal GB of demand-populated
# mapped expert residency under one all-inclusive 4.5-decimal-GB current-RSS
# ceiling. Platform recipes may replace both values together.
SALT_EXPERT_BUDGET_GB=1
SALT_EXPERT_PRELOAD=0
SALT_EXPERT_PRELOAD_LAYERS=none
SALT_FULL_MIN_RAM_GB=20
SALT_GEMMA_MEMORY_LIMIT_GB=4.5
# A READY hit and an ordinary newly mapped resource enter compute from the same
# resident-slot payload ledger. Only strict proof drains this gate+up prefix
# before publishing strict READY.
SALT_FETCH_TOUCH_BYTES=2230272
