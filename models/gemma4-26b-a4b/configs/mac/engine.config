# Gemma 4 Mac operation/resource recipe.
SALT_GEMMA_PLATFORM_RECIPE=mac

# CPU is the accepted Mac operating mode. Full Metal has exact qualification
# evidence but remains a separate performance-gated recipe.
SALT_GEMMA_COMPUTE_NODE=cpu
SALT_GPU_TRUNK=0
SALT_GPU_BOUNDED_WEIGHTS=1
SALT_GPU_EXPERT_VIEW=selected
SALT_METAL_Q4_SIMDGROUPS=0
SALT_METAL_Q4_MAX_DESCRIPTORS=0
SALT_GEMMA_METAL_EXACT_CELLS=0
SALT_TARGET_GPU_PROGRAM=0
# Restore the fast CPU structure: the graph-off TARGET interpreter retains
# weight-stationary X-row ownership and coalesced same-epoch matrix waves.  The
# retained host-span graph and fine-token B1 path remain compiled controls, not
# the Mac operating default.
SALT_TARGET_CPU_GRAPH=0
SALT_TARGET_MATRIX_FLOW=0
SALT_TEXT_FINE_TOKEN=0
SALT_GPU_TRUNK_B=200
SALT_GPU_PREFILL_B=1024
SALT_GPU_B_QKV=1024
SALT_GPU_B_Z=1024
SALT_GPU_B_O=1024

# Qualified W8 tree-frontier CPU baseline.
SALT_TOKEN_CPU_FLOW=0
SALT_TOKEN_CPU_GRAPH=0
SALT_PREFILL_CHUNK=1
SALT_PREFILL_B=512
SALT_PREFILL_OPERATION_FLOW=0
# Experimental all-worker PREFILL traversal. Default off; same B/operators.
SALT_GEMMA_PREFILL_TEAM=0
SALT_PREFILL_RETAIN_LAYERS=1
SALT_PREFILL_DECODE_LOOKAHEAD=0
SALT_PREFILL_SHARED_ARENAS=0
SALT_PREFILL_GPU_ATTENTION=0
SALT_M2_BATCH=1
SALT_QKV_BATCH=1
SALT_ATTN_THREADS=8
SALT_TARGET_AREA_WORKERS=8
# Historical ordinary B1: each W8 worker owns one selected expert's complete
# gate -> up -> activation -> down chain for the pool generation.
SALT_EXPERT_MATRIX_WAVES=0
# Matched Mac CPU/Metal split: N64/F1/Q4 is the NFQ check-board and X64 is the
# independent causal target-row count on both physical backends.
SALT_TARGET_ROUTE_N=64
SALT_TARGET_X=64
SALT_TARGET_KV_WARMUP_ROWS=512
SALT_TARGET_WARM_X=4
SALT_TARGET_ROUTE_F=1
SALT_TARGET_ROUTE_Q=4
SALT_DPR_DRAFT_N=64
SALT_EXPERT_BUDGET_GB=1
SALT_EXPERT_PRELOAD=0
SALT_EXPERT_PRELOAD_LAYERS=none
SALT_FULL_MIN_RAM_GB=20
SALT_GEMMA_MEMORY_LIMIT_GB=4.5
# Restore ordinary CPU consumer-touch without making proof select preparation.
# Empty clears the base prefix while preserving persistent fetch workers and
# bounded mmap/readahead. Literal 0 selects a different device-fault-only path.
SALT_FETCH_TOUCH_BYTES=
SALT_FETCH_TOUCH=0
