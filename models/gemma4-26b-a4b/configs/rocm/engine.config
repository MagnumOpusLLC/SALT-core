# Gemma 4 AMD ROCm low-cost V520 full-GPU hosting candidate.
SALT_GEMMA_PLATFORM_RECIPE=rocm

SALT_GEMMA_COMPUTE_NODE=full
SALT_GPU_TRUNK=1
SALT_GPU_BOUNDED_WEIGHTS=1
SALT_GPU_WEIGHT_ADDRESSABILITY=bounded-window
SALT_GPU_TRUNK_LAYER_VIEW=0
SALT_GPU_TRUNK_SHARED_POOL=1
SALT_GPU_TRUNK_EXACT_VIEWS=1
# Device-local physical realization: Task 3 populates the complete shared trunk;
# Task 4 will bind demand-selected experts into the already fixed empty slots.
SALT_GPU_RESIDENCY=device-local
SALT_GPU_RESIDENCY_EXPERT_GB=4
SALT_GPU_RESIDENCY_STAGING_MB=16
SALT_GPU_RESIDENCY_STAGING_SLOTS=2
SALT_GPU_EXPERT_VIEW=selected
SALT_METAL_Q4_SIMDGROUPS=0
SALT_METAL_Q4_MAX_DESCRIPTORS=0
SALT_GEMMA_METAL_EXACT_CELLS=0
# The V520 is intentionally accepted as a slower accelerator tier. Keep the
# complete HIP X-TARGET program available independently of NFQ N/F/Q checks.
SALT_TARGET_GPU_PROGRAM=1
SALT_TARGET_CPU_GRAPH=0
# Keep the cold authoritative bootstrap/correction inside the same complete HIP
# text program as PREFILL/TARGET. The scheduler must return to retained
# projection/NFQ selection and X-TARGET after this bounded known-token transition; this is not a
# repeated B1 serving loop.
SALT_TEXT_FINE_TOKEN=1
# X-TARGET-only wrappers enable this for an actual DPR transaction. The base
# ordinary recipe must remain admissible without --dpr-proof.
SALT_TARGET_GPU_EXPERTS=0
SALT_TARGET_N_PARALLEL=0
SALT_TARGET_MATRIX_FLOW=0
SALT_EXPERT_MATRIX_WAVES=0
SALT_GPU_TRUNK_B=1
SALT_GPU_PREFILL_B=256
SALT_GPU_B_QKV=256
SALT_GPU_B_Z=256
SALT_GPU_B_O=256

SALT_PREFILL_CHUNK=1
SALT_PREFILL_B=128
SALT_PREFILL_OPERATION_FLOW=0
# Bounded-window GPU PREFILL uses the same release-per-layer resource contract
# as Spark-HMM; RETAIN_OPERATION is rejected by the shared GPU PREFILL entry.
SALT_PREFILL_RETAIN_LAYERS=0
SALT_PREFILL_DECODE_LOOKAHEAD=0
SALT_PREFILL_SHARED_ARENAS=1
SALT_PREFILL_GPU_ATTENTION=1
# ROCm PREFILL publishes device-live hybrid KV. Ordinary decode must consume the
# same device-live ring; disabling either control diverges at the second token.
# This is a physical HIP continuity requirement, not a different engine flow.
SALT_GEMMA_GPU_KV_RING=1
SALT_DECODE_GPU_ATTENTION=1
SALT_M2_BATCH=1
SALT_QKV_BATCH=1
SALT_ATTN_THREADS=8
SALT_TARGET_AREA_WORKERS=8
# V520 split: N104/F1/Q4 is the cheap NFQ check-board and X16 is the independent
# causal target-row count. Semantic F is not physical wave count; HIP derives
# physical workgroups from occupancy.
SALT_TARGET_ROUTE_N=104
SALT_TARGET_X=16
SALT_TARGET_KV_WARMUP_ROWS=512
SALT_TARGET_WARM_X=4
SALT_TARGET_ROUTE_F=1
SALT_TARGET_ROUTE_Q=4
SALT_DPR_DRAFT_N=104

# AMD-private physical realization for the Radeon Pro V520 (36 CU, wave32).
# These values affect only HIP workgroup assignment, never model geometry,
# routing, arithmetic order, state, or commit authority.
SALT_HIP_TEXT_SELECTED_WAVE=1
SALT_HIP_TEXT_NROW=1
SALT_HIP_TEXT_PAIR=1
SALT_HIP_TEXT_SYSTEM_FENCE=0
SALT_HIP_TEXT_WAVE_GROUPS=8
SALT_HIP_TEXT_BF16_WAVE_GROUPS=8
SALT_HIP_TEXT_NROW_MIN_B=8
SALT_EXPERT_BUDGET_GB=3
SALT_EXPERT_PRELOAD=0
SALT_EXPERT_PRELOAD_LAYERS=none
SALT_FULL_MIN_RAM_GB=8
SALT_GEMMA_MEMORY_LIMIT_GB=7.5
SALT_FETCH_TOUCH_BYTES=2230272
