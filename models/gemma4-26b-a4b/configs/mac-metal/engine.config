# Gemma 4 Mac full-Metal bounded qualification recipe.
SALT_GEMMA_PLATFORM_RECIPE=mac-metal

SALT_GEMMA_COMPUTE_NODE=full
SALT_GPU_TRUNK=1
SALT_GPU_BOUNDED_WEIGHTS=1
SALT_GPU_TRUNK_LAYER_VIEW=0
SALT_GPU_TRUNK_SHARED_POOL=1
SALT_GPU_TRUNK_EXACT_VIEWS=1
SALT_GPU_EXPERT_VIEW=selected
SALT_METAL_LIBRARY=salt-gpu.metallib
SALT_METAL_Q4_SIMDGROUPS=0
SALT_METAL_Q4_MAX_DESCRIPTORS=0
SALT_METAL_Q4_WEIGHT_STATIONARY_MIN_B=16
SALT_GEMMA_METAL_EXACT_CELLS=0
# Historical target X16 evidence is exact; ordinary compiled B1 remains performance-RED.
SALT_TARGET_GPU_PROGRAM=1
SALT_TARGET_CPU_GRAPH=0
SALT_TEXT_FINE_TOKEN=0
SALT_GPU_TRUNK_B=1
SALT_GPU_PREFILL_B=512
SALT_GPU_B_QKV=512
SALT_GPU_B_Z=512
SALT_GPU_B_O=512

SALT_PREFILL_CHUNK=1
SALT_PREFILL_B=512
SALT_PREFILL_OPERATION_FLOW=0
SALT_PREFILL_RETAIN_LAYERS=1
SALT_PREFILL_DECODE_LOOKAHEAD=0
SALT_PREFILL_SHARED_ARENAS=1
SALT_PREFILL_GPU_ATTENTION=1
# Gemma hybrid KV remains model-owned on Metal: 25 sliding layers use the
# 1,024-row ring while five full-attention layers remain absolute.
SALT_GEMMA_GPU_KV_RING=1
SALT_M2_BATCH=1
SALT_QKV_BATCH=1
SALT_ATTN_THREADS=8
SALT_TARGET_AREA_WORKERS=8
# Matched Mac split: N64/F1/Q4 is NFQ-only and X64 is causal target rows.
SALT_TARGET_ROUTE_N=64
SALT_TARGET_X=64
SALT_TARGET_KV_WARMUP_ROWS=512
SALT_TARGET_WARM_X=4
SALT_TARGET_ROUTE_F=1
SALT_TARGET_ROUTE_Q=4
SALT_DPR_DRAFT_N=64
SALT_EXPERT_BUDGET_GB=1
SALT_EXPERT_PRELOAD=0
SALT_EXPERT_PRELOAD_LAYERS=none
SALT_FULL_MIN_RAM_GB=20
SALT_FETCH_TOUCH_BYTES=2230272
SALT_GEMMA_MEMORY_LIMIT_GB=4.5
