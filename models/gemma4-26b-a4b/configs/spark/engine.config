# Gemma 4 DGX Spark/GB10 full-CUDA operation/resource recipe.
SALT_GEMMA_PLATFORM_RECIPE=spark

# Requires an explicit CUDA=1 build. Full intent fails closed on any missing
# source registration, projection, synchronization, or teardown boundary.
SALT_GEMMA_COMPUTE_NODE=full
SALT_GPU_TRUNK=1
SALT_GPU_BOUNDED_WEIGHTS=0
SALT_GPU_EXPERT_VIEW=selected
SALT_METAL_Q4_SIMDGROUPS=0
SALT_METAL_Q4_MAX_DESCRIPTORS=0
SALT_GEMMA_METAL_EXACT_CELLS=0
# The complete X-row target GraphExec is qualified. Ordinary compiled B1 remains
# slower than the accepted phase-mixed decode path and stays disabled.
SALT_TARGET_GPU_PROGRAM=1
SALT_TARGET_CPU_GRAPH=0
SALT_TEXT_FINE_TOKEN=0
SALT_GPU_TRUNK_B=1
SALT_GPU_PREFILL_B=512
SALT_GPU_B_QKV=512
SALT_GPU_B_Z=512
SALT_GPU_B_O=512

# GB10 has 130.661 GB unified memory. Register all authenticated source shards
# and the canonical pool once; retain all 3,840 expert slots for engine life.
# The all-inclusive RSS admission ceiling is hard-limited to 60 decimal GB.
# B=256 is model-owned: routed gate/up expands to exactly 4,096 CUDA jobs.
SALT_PREFILL_CHUNK=1
SALT_PREFILL_B=256
SALT_PREFILL_OPERATION_FLOW=0
SALT_PREFILL_RETAIN_LAYERS=1
SALT_PREFILL_DECODE_LOOKAHEAD=0
SALT_PREFILL_SHARED_ARENAS=1
SALT_PREFILL_GPU_ATTENTION=1
SALT_M2_BATCH=1
SALT_QKV_BATCH=1
SALT_ATTN_THREADS=8
# Requested CPU budget for target area scans; wider rows are diagnostic only.
SALT_TARGET_AREA_WORKERS=8
# Platform split: N48/F1/Q4 is NFQ-only and X48 is causal target rows.
SALT_TARGET_ROUTE_N=48
SALT_TARGET_X=48
SALT_TARGET_KV_WARMUP_ROWS=512
SALT_TARGET_WARM_X=4
SALT_TARGET_ROUTE_F=1
SALT_TARGET_ROUTE_Q=4
SALT_EXPERT_BUDGET_GB=13
SALT_EXPERT_PRELOAD=1
SALT_EXPERT_PRELOAD_LAYERS=none
SALT_FULL_MIN_RAM_GB=32
SALT_GEMMA_MEMORY_LIMIT_GB=60
SALT_FETCH_TOUCH_BYTES=2230272
