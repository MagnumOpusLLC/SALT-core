# Gemma 4 DGX Spark/GB10 runtime recipe: CPU-authoritative text plus
# pageable-HMM CUDA vision. The vision tower reads the authenticated source
# mapping directly; no learned-weight registration, copy, or repack is allowed.
SALT_GEMMA_PLATFORM_RECIPE=spark-hmm-vision
SALT_GEMMA_COMPUTE_NODE=cpu
SALT_GPU_TRUNK=0
SALT_GPU_BOUNDED_WEIGHTS=0
SALT_GPU_WEIGHT_ADDRESSABILITY=auto
SALT_CUDA_PAGEABLE_MMAP=1
SALT_GEMMA_VISION_CUDA_HMM=1
SALT_GPU_TRUNK_LAYER_VIEW=0
SALT_GPU_TRUNK_SHARED_POOL=0
SALT_GPU_TRUNK_EXACT_VIEWS=0
SALT_GPU_EXPERT_VIEW=selected
SALT_METAL_Q4_SIMDGROUPS=0
SALT_METAL_Q4_MAX_DESCRIPTORS=0
SALT_GEMMA_METAL_EXACT_CELLS=0
SALT_TARGET_GPU_PROGRAM=0
SALT_TARGET_CPU_GRAPH=0
SALT_TEXT_FINE_TOKEN=0

# Retain the qualified CPU text path. Only the vision matrix executor uses CUDA.
SALT_PREFILL_CHUNK=1
SALT_PREFILL_B=512
SALT_PREFILL_OPERATION_FLOW=0
SALT_PREFILL_RETAIN_LAYERS=1
SALT_PREFILL_DECODE_LOOKAHEAD=0
SALT_PREFILL_SHARED_ARENAS=0
SALT_PREFILL_GPU_ATTENTION=0
SALT_M2_BATCH=1
SALT_QKV_BATCH=1
SALT_ATTN_THREADS=8
SALT_TARGET_AREA_WORKERS=8
# Text remains CPU-authoritative. N32/F1/Q4 is NFQ-only; X32 is causal target
# rows executed by the persistent W8 row-tile frontier.
SALT_EXPERT_MATRIX_WAVES=1
SALT_TARGET_ROUTE_N=32
SALT_TARGET_X=32
SALT_TARGET_KV_WARMUP_ROWS=512
SALT_TARGET_WARM_X=4
SALT_TARGET_ROUTE_F=1
SALT_TARGET_ROUTE_Q=4
SALT_EXPERT_BUDGET_GB=1
SALT_EXPERT_PRELOAD=0
SALT_EXPERT_PRELOAD_LAYERS=none
SALT_FULL_MIN_RAM_GB=8
SALT_GEMMA_MEMORY_LIMIT_GB=7
# Ordinary CPU text consumers reuse the selected resident-slot ledger address
# directly. This prefix is touched synchronously only under strict proof.
SALT_FETCH_TOUCH_BYTES=2230272
