# Gemma 4 DGX Spark/GB10 bounded pageable-HMM qualification recipe.
SALT_GEMMA_PLATFORM_RECIPE=spark-hmm

# This is the low-registration CUDA mode. Dense and routed-expert tensors use
# canonical process-lifetime pageable views of the authenticated source maps.
# The mapping is addressability only: it does not preload, register, or copy the
# payload, and pageable residency remains governed by the host memory system.
SALT_GEMMA_COMPUTE_NODE=full
SALT_GPU_TRUNK=1
SALT_GPU_BOUNDED_WEIGHTS=1
SALT_GPU_WEIGHT_ADDRESSABILITY=pageable
SALT_CUDA_PAGEABLE_MMAP=1
SALT_GPU_TRUNK_LAYER_VIEW=0
SALT_GPU_TRUNK_SHARED_POOL=0
SALT_GPU_TRUNK_EXACT_VIEWS=0
SALT_GPU_EXPERT_VIEW=selected
SALT_METAL_Q4_SIMDGROUPS=0
SALT_METAL_Q4_MAX_DESCRIPTORS=0
SALT_GEMMA_METAL_EXACT_CELLS=0
# HMM B1 Fine-token and X-TARGET use the existing dynamic-resource text program:
# selected expert leases resume through SaltCache while model cells remain in
# the engine-owned CUDA canonical arena. X=1 is the normal one-row continuous
# GPU decode and must not fall back to the host-barrier token program.
SALT_TARGET_GPU_PROGRAM=1
SALT_TARGET_CPU_GRAPH=0
SALT_TEXT_FINE_TOKEN=1
SALT_GPU_TRUNK_B=1
SALT_GPU_PREFILL_B=512
SALT_GPU_B_QKV=512
SALT_GPU_B_Z=512
SALT_GPU_B_O=512

# Keep the qualified Spark projection geometry while releasing completed dense
# source ranges and retaining only the demand-selected expert budget.
# Full-text pageable HMM remains a default-off qualification candidate.
SALT_PREFILL_CHUNK=1
SALT_PREFILL_B=256
SALT_PREFILL_OPERATION_FLOW=0
SALT_PREFILL_RETAIN_LAYERS=0
SALT_PREFILL_DECODE_LOOKAHEAD=0
SALT_PREFILL_SHARED_ARENAS=1
SALT_PREFILL_GPU_ATTENTION=1
SALT_M2_BATCH=1
SALT_QKV_BATCH=1
SALT_ATTN_THREADS=8
SALT_TARGET_AREA_WORKERS=8
# Platform split: N48/F1/Q4 is the cheap NFQ check-board; X48 independently
# controls consecutive causal target rows.
SALT_TARGET_ROUTE_N=48
SALT_TARGET_X=48
SALT_TARGET_KV_WARMUP_ROWS=512
# Historical HMM serving admission: X1 before the 512-row prior-KV
# boundary, then X4; the recipe maximum remains X48.
SALT_TARGET_WARM_X=4
SALT_TARGET_ROUTE_F=1
SALT_TARGET_ROUTE_Q=4
SALT_DPR_DRAFT_N=48
# Two decimal GB keeps the bounded demand-selected CUDA expert working set while
# preserving pageable-HMM source ownership and the 16-GB all-inclusive RSS gate.
SALT_EXPERT_BUDGET_GB=2
SALT_EXPERT_PRELOAD=0
SALT_EXPERT_PRELOAD_LAYERS=none
SALT_FULL_MIN_RAM_GB=8
SALT_GEMMA_MEMORY_LIMIT_GB=16
SALT_FETCH_TOUCH_BYTES=3345408
SALT_FETCH_TOUCH=1
