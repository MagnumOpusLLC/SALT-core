# Gemma 4 EC2 x86_64 CPU operation/resource recipe.
SALT_GEMMA_PLATFORM_RECIPE=ec2

# Ordinary Linux builds remain CUDA-free unless make is given CUDA=1.
SALT_GEMMA_COMPUTE_NODE=cpu
SALT_GPU_TRUNK=0
SALT_GPU_BOUNDED_WEIGHTS=1
SALT_GPU_EXPERT_VIEW=selected
SALT_METAL_Q4_SIMDGROUPS=0
SALT_METAL_Q4_MAX_DESCRIPTORS=0
SALT_GEMMA_METAL_EXACT_CELLS=0
SALT_TARGET_GPU_PROGRAM=0
SALT_TARGET_CPU_GRAPH=0
SALT_TARGET_N_PARALLEL=0
SALT_TARGET_MATRIX_FLOW=0
SALT_TEXT_FINE_TOKEN=0
SALT_GPU_TRUNK_B=200
SALT_GPU_PREFILL_B=1024
SALT_GPU_B_QKV=1024
SALT_GPU_B_Z=1024
SALT_GPU_B_O=1024

# EC2 W8 CPU baseline; NFQ checking and causal X-TARGET remain separate.
SALT_TOKEN_CPU_FLOW=0
SALT_TOKEN_CPU_GRAPH=0
SALT_PREFILL_CHUNK=1
SALT_PREFILL_B=512
SALT_PREFILL_OPERATION_FLOW=0
SALT_PREFILL_RETAIN_LAYERS=1
SALT_PREFILL_DECODE_LOOKAHEAD=0
SALT_PREFILL_SHARED_ARENAS=0
SALT_PREFILL_GPU_ATTENTION=0
SALT_M2_BATCH=1
SALT_QKV_BATCH=1
SALT_ATTN_THREADS=8
SALT_TARGET_AREA_WORKERS=8
# Ordinary selected experts use the persistent W8 row-tile frontier. Arithmetic,
# canonical destinations, leases, and the layer dependency fence are unchanged.
SALT_EXPERT_MATRIX_WAVES=0
# Platform split: N32/F1/Q4 is NFQ-only and X32 is causal target rows.
SALT_TARGET_ROUTE_N=32
SALT_TARGET_X=32
SALT_TARGET_KV_WARMUP_ROWS=512
SALT_TARGET_WARM_X=4
SALT_TARGET_ROUTE_F=1
SALT_TARGET_ROUTE_Q=4
SALT_DPR_DRAFT_N=32
SALT_EXPERT_BUDGET_GB=6
SALT_EXPERT_PRELOAD=0
SALT_EXPERT_PRELOAD_LAYERS=none
SALT_FULL_MIN_RAM_GB=8
SALT_GEMMA_MEMORY_LIMIT_GB=14
# Ordinary CPU consumers reuse the selected resident-slot ledger address
# directly. This prefix is touched synchronously only under strict proof.
SALT_FETCH_TOUCH_BYTES=2230272
