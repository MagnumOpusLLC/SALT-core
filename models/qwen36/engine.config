# models/qwen36/engine.config -- the engine component blueprint.
#
# Every engine component is wired here as DATA: the three registries
# (model / quant / layers), the assets (ENV-overridable), the
# compute modes and the decoding knobs. A new model = a new folder
# with its own blueprint; the engine itself never changes.

# ---- the registries (the engine's component selection) ----
# the model-registry entry (src/model.c -- the geometry)
MODEL=qwen36
# the quant-registry entry (src/quant.c -- the format module)
QUANT=mlx4
# the layer-registry fill (src/layer.c -- the kinds + the gates)
LAYERS=qwen36

# ---- the assets (the bins; every path ENV-overridable) ----
# SALT_ENG_ROOT, SALT_QUANT override the cache root at runtime; the
# per-quant setup (configs/mlx4/setup.sh) recreates the derived
# assets (config.json, tokenizer, prompts) from the manifest.
MODEL_TRUNK=/Volumes/prod/hf-cache/mlx4-eng
MODEL_POOL=/Volumes/prod/hf-cache/mlx4-eng
MODEL_TOKENIZER=/Volumes/prod/hf-cache/mlx4-eng/tokenizer.json

# ---- the compute modes (the offload blueprint) ----
# CPU remains the operational default and rollback. The qualified Metal mode is
# prefill-only: bounded source-backed GPU trunk projections, then CPU decode.
SALT_GPU=0
SALT_GPU_RESIDENT=1
SALT_GPU_TRUNK=1
SALT_GPU_MOE=0
SALT_GPU_OVERLAP=0
SALT_GPU_TRUNK_PREFILL_ONLY=1
# Qwen3.6-35B-A3B crossover qualified at actual B>=200. This threshold belongs
# to this model/quant geometry and must not become a universal engine default;
# shorter prompts and sub-threshold tail chunks stay on the CPU trunk.
SALT_GPU_TRUNK_B=200
SALT_GPU_PREFILL_B=1024
SALT_GPU_B_QKV=1024
SALT_GPU_B_Z=1024
SALT_GPU_B_O=1024
# Measured only for Qwen3.6-35B-A3B on the mlx4 track. Re-measure for
# different active parameter counts/expert dimensions; do not inherit 128.
SALT_M2_BATCH=1
SALT_M2_BATCH_B=128
SALT_CACHE_MODE=zerocopy

# ---- the runner defaults ----
RUN_CACHE_GB=5
RUN_PIN_LAYERS=41
CHAT_THREADS=8
CHAT_KV_BUDGET_GB=1.0
RUN_MAX_TOKENS=2048

# ---- the decoding (the measured 4-bit knobs) ----
SALT_PREFILL_CHUNK=1
SALT_PREFILL_B=512
