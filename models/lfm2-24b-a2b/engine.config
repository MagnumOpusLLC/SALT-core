# LFM2.5-24B-A2B model-owned policy. Values are not inherited from Gemma/Qwen/Maple.
# CPU-first bring-up on the GB10 dev host; accelerator enablement is a separate,
# separately gated step and must not be inferred from CPU support.
MODEL=lfm2-24b-a2b
MODEL_ID=lfm2-24b-a2b
QUANT=mlx4-6e
LFM_GPU=0
LFM_CONTEXT=2048
LFM_PREFILL_B=32
# M4 Pro selected Metal PREFILL width. B256 preserved exact complete state and
# beat B32/B128/B512 on the matched P480/O64 cell under the 3.5-GB RSS ceiling.
LFM_METAL_PREFILL_B=256
LFM_WORKERS=8
# 2 decimal-GB demand-selected expert payload ceiling for the CPU/small-host
# operating point; no preload and no copied expert pool.
# 376 slots x 5,308,416 bytes = 1,995,964,416 bytes.
LFM_EXPERT_SLOTS=376
# DGX Spark CUDA conservative operating point.  The cache owns the sole bounded
# expert mappings; unused slots consume no payload RSS and there is no whole-pool
# mapping.  P480/O8 measured 3.654 GB peak RSS, while P4096/O100 measured
# 3.743 GB under the all-inclusive 4-GB cutoff with complete state identity.
# 448 slots x 5,308,416 bytes = 2,378,170,368 bytes maximum expert payload.
LFM_CUDA_EXPERT_SLOTS=448
LFM_CUDA_RSS_LIMIT_BYTES=4000000000
# Mac Metal keeps wide PREFILL on the device and uses the same portable CPU
# executor for ordinary B1 decode.  Build with LFM_METAL_MIXED_DECODE=0 to
# retain the independently selectable full-Metal control.
LFM_METAL_MIXED_DECODE=1
LFM_TOKENIZER_LAYOUT=compact-merges-v1
LFM_RSS_LIMIT_BYTES=3500000000
LFM_OUTPUT_CAP=1000
