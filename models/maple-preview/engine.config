# Experimental CPU-only Maple policy; values are not inherited from Gemma/Qwen.
MODEL=maple-preview
MODEL_ID=maple-preview
QUANT=row-int2
SALT_GPU=0
MAPLE_CONTEXT=2048
MAPLE_PREFILL_B=16
MAPLE_WORKERS=8
# 2 decimal-GB demand-selected expert payload ceiling; no preload or copies.
MAPLE_EXPERT_SLOTS=2504
MAPLE_TOKENIZER_LAYOUT=compact-merges-v1
MAPLE_RSS_LIMIT_BYTES=3500000000
MAPLE_OUTPUT_CAP=1000
