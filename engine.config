# engine.config -- single source of truth for model artifacts, runners
# and defaults. Read by bash runners (source engine.config) and by the
# python tools (tools/engine_config.py: load_engine_config()).
#
# Format: KEY=VALUE, one per line, no spaces around '='. Values are
# absolute paths or plain numbers -- no shell expansion, no quotes.
# Lines starting with '#' are comments.

# ---- model artifacts (Qwen3.6 track, live) ----
# The operating track is the mlx4 (4-bit) -- the gate, the validation
# and the benchmarks all run it. The per-quant asset setup
# (configs/mlx4/setup.sh) recreates the small derived assets; the
# MODEL_* paths can be overridden by the ENV (SALT_QUANT etc).
# The ACTIVE MODEL'S BLUEPRINT lives in models/<model>/engine.config
# (MODEL_DIR) -- the registry selection, the assets, the compute
# modes, the decoding. This file holds the shared runner defaults.
MODEL_DIR=models/qwen36
MODEL=qwen36
QUANT=mlx4
MODEL_TRUNK=/Volumes/prod/hf-cache/mlx4-eng
MODEL_POOL=/Volumes/prod/hf-cache/mlx4-eng
MODEL_TOKENIZER=/Volumes/prod/hf-cache/mlx4-eng/tokenizer.json

# ---- reference forward artifacts (Qwen3.6, determinism regression) ----
# reference forward artifacts: the 3.6 model is the reference for
# the engine's 3.6 runs (dbg-reffwd defaults to MODEL_* when the
# REF_* env is unset -- the old /tmp/q35-* pins here were the 3.5
# frozen fixtures and silently validated the wrong checkpoint).
REF_TRUNK=/tmp/q36-trunk
REF_POOL=/tmp/q36-pool
REF_TOKENIZER=/tmp/q36-trunk/tokenizer.json

# ---- engine binary (relative to the repo root) ----
SALT_BIN=salt

# ---- python interpreters ----
# CHAT_PYTHON: has tokenizers (salt-chat.py, dbg-reffwd.py, convertors)
CHAT_PYTHON=/Volumes/prod/miniforge3/envs/ca_lpp/bin/python3
# RUN_PYTHON: clean python for reference-forward tooling (no conda
# shadowing; run-clean.sh semantics)
RUN_PYTHON=/Users/ruihe/salt-qwen3.5-35B-A3B-mlx4/.venv/bin/python3

# ---- runner defaults ----
RUN_GEN=4
RUN_CACHE_GB=5
RUN_LIMIT=23
RUN_PIN_LAYERS=41

# ---- chat (salt-chat.py) defaults ----
CHAT_GEN=60
CHAT_THREADS=8
CHAT_KV_BUDGET_GB=1.0
CHAT_FIFO=/tmp/salt-chat.fifo

# ---- compute mode (CPU/GPU) ----
# SALT_GPU: 0 = CPU-only (the byte-deterministic anchor; NEON + the
# mmap'd pool -- the right choice for the MoE at A3B scale), 1 =
# Metal offload (zero-copy pool residency + the projection batch for
# the dense main pipeline). The MoE stays CPU in both modes.
# SALT_GPU_RESIDENT: 1 = wrap the pool mmap zero-copy (the GPU reads
# the SAME physical pages); 0 = per-token first-sight arena copies
# (debug only).
# SALT_GPU_TRUNK: 1 = also route the main-pipeline dense projections
# (the lin body's qkv/z/o, the GQA q/k/v/o, the head) through the
# GPU residency -- the actual win at this scale.
# SALT_GPU_MOE: 1 = route the routed experts through the GPU batch.
# Default 0 -- at A3B scale the MoE is too small to beat the CPU
# NEON path (the dispatch overhead eats the compute); the MoE stays
# CPU in both modes.
SALT_GPU=0
SALT_GPU_RESIDENT=1
SALT_GPU_TRUNK=1
SALT_GPU_MOE=0

# SALT_GPU_OVERLAP: the concurrent per-layer schedule -- the z/o
# projections (the GPU, they depend only on x) run while the GQA
# attention (the CPU, it needs only the qkv) runs -- the two are
# independent, so the attn's serial pass overlaps the GPU's z/o
# stream. 0 = the serial schedule (the default; the byte-deterministic
# anchor). 1 = the overlapped schedule (bit-identical by construction
# -- the same matvecs on the same inputs, just concurrent).
SALT_GPU_OVERLAP=0

# ---- bit-exact env (determinism contract) ----
# Discrete batch sizes: SALT_PREFILL_B is the CPU chunk (512 = the
# measured sweet spot for the tiled batch). The GPU proj-batch's B is
# per-layer, tuned to the projection shape: SALT_GPU_B_QKV (the
# 8192-row qkv), SALT_GPU_B_Z (the 4096-row z), SALT_GPU_B_O (the
# 2048-row o), with SALT_GPU_PREFILL_B as the default (1024; the
# literal "MAX" = the whole prompt -- the GPU amortizes the dispatch
# at the bigger B).
SALT_PREFILL_CHUNK=1
SALT_PREFILL_B=512
SALT_GPU_PREFILL_B=1024
SALT_GPU_B_QKV=1024
SALT_GPU_B_Z=1024
SALT_GPU_B_O=1024
# Grouped-MoE enablement and crossover are model/expert-geometry specific.
# They live in models/<model>/engine.config, not in shared engine defaults.
SALT_CACHE_MODE=zerocopy
# ---- generation defaults ----
# the runner's default output budget (tokens); the engine's --gen is
# uncapped, this is the chat/runner ceiling.
RUN_MAX_TOKENS=2048

# ---- decoding (measured on THIS 4-bit checkpoint) ----
# Q4 arithmetic uses one fixed logical-32 graph. Physical lane width is
# selected by the compiled SIMD substrate and is not a runtime option.
# The official card recipe (sampling top_k=20 top_p=0.95 temp=1.0
# + presence_penalty=1.5) assumes full precision. On the 4-bit
# checkpoint the flat logits make sampling degenerate ("The
# capital?" for the France question) while greedy + the additive
# penalties answer cleanly ("The capital of France is Paris.").
# A/B measured on the exact server framing:
#   official:            question-echo loop / degenerate
#   official + freq 1.0: same
#   greedy + rep1.4 + freq1.0: CORRECT ANSWER
# The additive frequency penalty (logits -= freq_pen * count) is
# the loop-killer; the multiplicative rep penalty alone cannot
# break 30-logit attractor peaks. SALT_GREEDY=1 = deterministic.
# The sampler knobs stay wired for reference (SALT_TOPK etc.).
SALT_GREEDY=1
SALT_REP_PENALTY=1.4
SALT_FREQ_PENALTY=1.0
SALT_PRESENCE_PENALTY=0.0
SALT_TOPK=20
SALT_TOP_P=0.95
SALT_TEMP=1.0
